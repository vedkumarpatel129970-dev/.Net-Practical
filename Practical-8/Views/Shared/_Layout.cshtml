<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - StockWise</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <header class="topbar">
        <div class="nav-container">
            <a class="brand" href="@Url.Action("Index", "Products")">
                <span class="brand-mark">S</span>
                <span>StockWise<small>INVENTORY MANAGER</small></span>
            </a>
            <nav>
                @Html.ActionLink("Dashboard", "Index", "Products", null, new { @class = "nav-link" })
                @Html.ActionLink("+ Add Product", "Create", "Products", null, new { @class = "nav-add" })
            </nav>
        </div>
    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div>© @DateTime.Now.Year StockWise Inventory Management</div>
        <div>Manage stock. Stay organised.</div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>