@model Practical8.Models.Product
@{
    ViewBag.Title = "Add Product";
}

<div class="form-page">
    <div class="form-header">
        <span class="eyebrow">INVENTORY / NEW ITEM</span>
        <h1>Add New Product</h1>
        <p class="muted">Enter the details below to add a product to your inventory.</p>
    </div>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

            <div class="form-grid">
                <div class="form-group full-width">
                    @Html.LabelFor(m => m.ProductName)
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-input", placeholder = "e.g. Wireless Keyboard" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "field-error" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Category)
                    @Html.TextBoxFor(m => m.Category, new { @class = "form-input", placeholder = "e.g. Electronics" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "field-error" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Quantity)
                    @Html.TextBoxFor(m => m.Quantity, new { @class = "form-input", type = "number", min = "0", placeholder = "Enter quantity" })
                    @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "field-error" })
                </div>
                <div class="form-group full-width">
                    @Html.LabelFor(m => m.Price)
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-input", type = "number", step = "0.01", min = "0.01", placeholder = "Enter price in ₹" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "field-error" })
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Product</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-light" })
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}