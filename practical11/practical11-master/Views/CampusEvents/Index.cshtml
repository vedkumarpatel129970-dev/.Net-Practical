@model IEnumerable<practical11.Models.CampusEvent>
@{
    ViewData["Title"] = "Campus Events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="eyebrow-label">Campus Calendar</div>
        <h1 class="h2 fw-bold text-navy mb-1">Campus Events</h1>
        <p class="text-muted mb-0">Discover activities and manage upcoming campus events.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2">
        + Add Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="campus-card p-5 text-center text-muted">
        <p class="fw-semibold mb-2">No campus events scheduled.</p>
        <p class="small mb-3">Create the first event to keep students informed.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add Event</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="campus-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="event-date-pill flex-shrink-0 px-3 py-2">
                            <span class="day">@ev.EventDate.ToString("dd")</span>
                            <span class="month">@ev.EventDate.ToString("MMM yyyy")</span>
                        </div>
                        <div>
                            <div class="eyebrow-label mb-1">Campus Event</div>
                            <h2 class="h5 fw-bold text-navy mb-1">@ev.Title</h2>
                            <div class="small text-muted">
                                @ev.Location &middot; @ev.EventDate.ToString("hh:mm tt")
                            </div>
                        </div>
                    </div>

                    <p class="text-secondary mb-4 flex-grow-1">@ev.Description</p>

                    <div class="d-flex gap-3 pt-2 border-top">
                        <a asp-action="Edit" asp-route-id="@ev.Id" class="text-decoration-none fw-semibold small">Edit event</a>
                        <a asp-action="Delete" asp-route-id="@ev.Id" class="text-danger text-decoration-none fw-semibold small">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
