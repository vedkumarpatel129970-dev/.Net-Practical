@model practical11.Models.ServiceRequest
@{
    ViewData["Title"] = $"Edit Request #{Model.Id}";
    var statuses = ViewBag.Statuses as string[] ?? ["Pending", "In Progress", "Resolved"];
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="eyebrow-label">Campus Support</div>
                <h1 class="h2 fw-bold text-navy mb-0">Edit Service Request #@Model.Id</h1>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Back to Requests</a>
        </div>

        <div class="campus-card p-4 p-md-5">
            <form asp-action="Edit" method="post" novalidate>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StudentName" class="form-label fw-semibold"></label>
                        <input asp-for="StudentName" class="form-control" />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Issue" class="form-label fw-semibold"></label>
                        <input asp-for="Issue" class="form-control" />
                        <span asp-validation-for="Issue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in statuses)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary fw-semibold">Cancel</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
