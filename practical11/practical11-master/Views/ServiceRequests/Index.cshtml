@model IEnumerable<practical11.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
    var currentStatus = ViewBag.Status as string;
    var currentSearch = ViewBag.Search as string;
    var statuses = ViewBag.Statuses as string[] ?? ["Pending", "In Progress", "Resolved"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="eyebrow-label">Campus Support</div>
        <h1 class="h2 fw-bold text-navy mb-1">Service Requests</h1>
        <p class="text-muted mb-0">Track and manage issues reported by students.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2">
        + New Request
    </a>
</div>

<div class="campus-card p-3 p-md-4 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-6 col-lg-7">
            <input type="text" name="search" value="@currentSearch" class="form-control"
                   placeholder="Search student, issue or department" aria-label="Search service requests" />
        </div>
        <div class="col-md-3 col-lg-2">
            <select name="status" class="form-select" aria-label="Filter by status">
                <option value="">All statuses</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(currentStatus == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-navy fw-semibold flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Clear</a>
        </div>
    </form>
</div>

<div class="campus-card overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <p class="mb-2 fw-semibold">No service requests found.</p>
            <p class="small mb-3">Try clearing your filters or submit a new service request.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">+ New Request</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table campus-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Student</th>
                        <th>Department</th>
                        <th>Issue</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-semibold">@item.Id</td>
                            <td class="fw-semibold text-dark">@item.StudentName</td>
                            <td class="text-muted">@item.Department</td>
                            <td>@item.Issue</td>
                            <td>
                                <partial name="_StatusBadge" model="item.Status" />
                            </td>
                            <td class="text-muted">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="pe-4 text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-link text-decoration-none fw-semibold px-2">View</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-link text-decoration-none fw-semibold px-2">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-link text-danger text-decoration-none fw-semibold px-2">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
