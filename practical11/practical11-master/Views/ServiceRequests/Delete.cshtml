@model practical11.Models.ServiceRequest
@{
    ViewData["Title"] = $"Delete Request #{Model.Id}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <div class="eyebrow-label text-danger">Confirm Deletion</div>
            <h1 class="h2 fw-bold text-navy mb-1">Delete Service Request #@Model.Id</h1>
            <p class="text-muted mb-0">This action will permanently remove the request from SQL Server.</p>
        </div>

        <div class="campus-card p-4 p-md-5 border-danger-subtle">
            <div class="alert alert-warning border-0 rounded-3 mb-4">
                Are you sure you want to delete this service request? This operation cannot be undone.
            </div>

            <dl class="row gy-2 mb-4">
                <dt class="col-sm-4 text-muted">Student Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.StudentName</dd>

                <dt class="col-sm-4 text-muted">Department</dt>
                <dd class="col-sm-8">@Model.Department</dd>

                <dt class="col-sm-4 text-muted">Issue</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Issue</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 text-muted">Status</dt>
                <dd class="col-sm-8">
                    <partial name="_StatusBadge" model="Model.Status" />
                </dd>

                <dt class="col-sm-4 text-muted">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 pt-3 border-top">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-danger fw-semibold px-4">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>
